{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/guide/layer-1.html",
      "destination": "/guide/identity.html",
      "permanent": true
    },
    {
      "source": "/guide/layer-2.html",
      "destination": "/guide/knowledge.html",
      "permanent": true
    },
    {
      "source": "/guide/layer-3.html",
      "destination": "/guide/limits.html",
      "permanent": true
    },
    {
      "source": "/guide/layer-4.html",
      "destination": "/guide/remember.html",
      "permanent": true
    },
    {
      "source": "/guide/layer-5.html",
      "destination": "/guide/improve.html",
      "permanent": true
    },
    {
      "source": "/guide/layer-6.html",
      "destination": "/guide/improve.html",
      "permanent": true
    }
  ]
}
